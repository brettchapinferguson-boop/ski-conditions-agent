# Anthropic API Key (Required)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Vercel KV (Required for caching)
# These are automatically provided when you add Vercel KV to your project
KV_REST_API_URL=https://xxxxx.kv.vercel-storage.com
KV_REST_API_TOKEN=xxxxx

# OpenWeather API Key (Optional)
# Get a free key from: https://openweathermap.org/api
# Only needed if you want to use OpenWeather for forecasts
OPENWEATHER_API_KEY=xxxxx
